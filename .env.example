# Daily Alarm Assistant — Environment Variables
# Copy this file to .env and fill in your values

# OpenAI
OPENAI_API_KEY=sk-...

# OpenWeatherMap (free tier — https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your_owm_key_here

# Location (Sorocaba, SP, BR)
WEATHER_CITY=Sorocaba
WEATHER_LAT=-23.5015
WEATHER_LON=-47.4526
WEATHER_UNITS=metric
WEATHER_LANG=pt_br

# OpenAI TTS voice: alloy | nova | echo | fable | onyx | shimmer
TTS_VOICE=nova

# OpenAI model for briefing generation
LLM_MODEL=gpt-4o-mini

# Path to fallback audio file (played when pipeline fails)
FALLBACK_AUDIO_PATH=fallback/fallback.mp3

# Path for temporary generated audio
OUTPUT_AUDIO_PATH=/tmp/alarm_briefing.mp3

